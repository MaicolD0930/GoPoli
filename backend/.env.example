# Copia este archivo a .env y pega la contraseña desde Neon (Connect → Connection string).
# NO subas .env a git.

# Proyecto GoPoli — rama production, pooling ON (recomendado para Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-plain-glitter-aqpu244n-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
# Solo la contraseña (NO pegues la URL postgresql://... entera aqui)
SPRING_DATASOURCE_PASSWORD=cambiar_por_password_neon

# Misma API key que frontend (Directions API en backend)
GOOGLE_MAPS_API_KEY=cambiar_por_api_key_google

# Opcional: deploy automatico a Render (scripts/deploy-render.ps1)
# RENDER_API_KEY=rnd_tu_api_key
